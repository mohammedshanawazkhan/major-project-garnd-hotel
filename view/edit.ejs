

<% layout("/layouts/boilerplate") %>
<body>
   <div class="form">
    <form action="/rooms/<%=data._id%>?_method=put" method="post"  novalidate class="needs-validation">
        <input type="text" name="roomNumber" value="<%=data.roomNumber%>" id="text" required>
        <div class="invalid-feedback">invalid</div>
        <br>
        <br>
        <input type="text" name="type" value="<%=data.type%>" id="text" required>
        <br>
        <br>
        <input type="text" name="floor" value="<%=data.floor%>" id="text" required>
        <br>
        <br>
        <input type="text" name="pricePerNight" value="<%=data.pricePerNight%>" id="text" required>
        <br>
        <br>
        <input type="text" name="status" value="<%=data.status%>" id="text" required>
        <br>
        <br>
        <input type="text" name="capacity" value="<%=data.capacity%>" id="text" required>
        <br>
        <br>
        <div >
            <img src="<%=data.image.url%>" alt="" style="height: 100px; width: 100px;"">
        </div>
        <input type="file" name="image" value="<%=data.image%>" id="text" required>
        <br>
        <br>
        <button class="btn">
            submit
        </button>
    </form>
    </div>
</body>
