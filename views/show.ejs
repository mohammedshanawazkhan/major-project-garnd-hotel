<% layout("/layouts/boilerplate") %>

<body>
  <div class="data">
  <div class="box-s">
  <div class="box-s-img">
    <img src="<%=Data.image.url%>" alt="">
  </div>
  <br>
   
  <div class="text">
  
    <b>TYPE</b>:<h3 id="h3"><%=Data.type%></h3>
  <br>
  <br>
  <b>STATUS</b>:<h3 id="h3"><%=Data.status%></h3>
  <br>
  <br>
  <b>PRICE PER NIGHT</b>:<h3 id="h3"><%=Data.pricePerNight%></h3>
  <br>
  <br>
  <b>FLOOR</b>:<h3 id="h3"><%=Data.floor%></h3>
  <br>
  <br>
  <b>ROOM NUMBER</b>:<h3 id="h3"><%=Data.roomNumber%></h3>
  </div>
<% if(user && Data.owner && req.user._id.equals(Data.owner._id)){%>

  <form action="/rooms/<%=Data._id%>/editpass" method="get"  novalidate class="needs-validation">
       <button class="btn">EDIT</button>
</form>
<form action="/rooms/<%=Data._id%>/delepass" method="get"  novalidate class="needs-validation">
       <button class="btn-2">DELETE</button>
</form>
<%}%>
<!-- <% if(Data.owner._id){ %>
   <h1 style="text-align: center;">Grand-Hotel is for your enjoyable Holiday</h1>
<%}%>
<% if(!Data.owner._id){ %>
   <h1 style="text-align: center;">Grand-Hotel is for your enjoyable Holiday</h1>
<%}%>

 





</div>
</div>



     <% if(user) {%>
    <div class="review">
      <h2>LEAVE REVIEW HEAR</h2>
      <form action="/rooms/<%=Data._id%>/review" method="post">
  <input type="text" id="rev" placeholder="comment" name="reviews[comment]" required>
  <br>
  <br>
  <div class="ra">
  <input type="number" id="rev" name="reviews[rating]">
  </div>
  <button class="btn-2-2">send</button>
  
</form>
    </div>
  <%}%>
  
  <div class="all">
      <h3>All Review</h3>
       <% for(let data of Data.reviews){ %>
        <b><%=data.author.username%></b>
        <p><%=data.comment%></p>
        <p><%=data.rating%></p>
        
        <form action="/rooms/<%=Data._id%>/review/<%=data._id%>?_method=DELETE" method="post">
          <button class="btn-2-2">delete</button>
        </form>
        <hr>
        
        
        <% } %>
    </div>
   



