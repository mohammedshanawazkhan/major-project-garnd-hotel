<% layout("/layouts/boilerplate") %>
<body>
    <div class="form">
    <form action="/rooms/new" method="post"novalidate class="needs-validation"  enctype="multipart/form-data">
        <label for="text">Room Number</label>
        <br>
        <input type="text" name="roomNumber" placeholder="enter room number" id="text" required>
        
        <br>
        <br>
        <label for="text">Type</label>
        <br>
        <input type="text" name="type" placeholder="enter the type" id="text" required>
        <div class="invalid-feedback">invalid-feedback</div>
        <br>
        <br>
        <label for="text">Floor</label>
        <br>
        <input type="number" name="floor" placeholder="enter the floor" id="text" required>
        
        <br>
        <br>
        <label for="text">Price-Per-Night</label>
        <br>
        <input type="text" name="pricePerNight" placeholder="enter the price" id="text" required>
       
        <br>
        <br>
        <label for="text">Status</label>
        <br>
        <input type="text" name="status" placeholder="enter the status" id="text" required>
        
        <br>
        <br>
        <label for="text">Capacity</label>
        <br>
        <input type="number" name="capacity" placeholder="enter the capacity" id="text" required>
        
        <br>
        <br>
        <label for="file">Link</label>
        <br>
        <input type="file" name="image" placeholder="enter the link" id="file" required>
       
        <br>
        <br>
        <button class="btn">
            submit
        </button>
    </form>
    </div>
    
</body>
