<% layout("/layouts/boilerplate") %>


<style>



.form-container{
    max-width:900px;
    margin:auto;
    background:#fff;
    padding:30px;
    border-radius:12px;
    box-shadow:0 4px 12px rgba(0,0,0,.1);
}

h2{
    color:#333;
    border-bottom:2px solid #eee;
    padding-bottom:10px;
    margin-bottom:25px;
}

.section{
    margin-bottom:25px;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

label{
    display:block;
    margin-bottom:6px;
    font-weight:600;
    color:#444;
}

input,
select{
    width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:6px;
    font-size:15px;
    transition:.3s;
}

input:focus,
select:focus{
    outline:none;
    border-color:#0078d7;
    box-shadow:0 0 5px rgba(0,120,215,.2);
}

.upload-box{
    border:2px dashed #d1d5db;
    border-radius:8px;
    padding:30px;
    text-align:center;
    background:#fafafa;
}

.upload-box:hover{
    border-color:#0078d7;
}

.btn{
    background:#0078d7;
    color:white;
    border:none;
    padding:12px 25px;
    border-radius:6px;
    font-size:16px;
    cursor:pointer;
    transition:.3s;
width:100%
}

.btn:hover{
    background:#005fa3;
}

@media(max-width:768px){

    .form-grid{
        grid-template-columns:1fr;
    }

    .btn{
        width:100%;
    }

}

</style>


<body>

<div class="form-container">

    <h2>Add New Room</h2>

    <form action="/rooms/new" method="post" enctype="multipart/form-data">

        <div class="section">

            <div class="form-grid">

                <div>
                    <label>Room Number</label>
                    <input
                        type="text"
                        name="roomNumber"
                        placeholder="Enter room number"
                        required>
                </div>

                <div>
                    <label>Room Type</label>
                    <select name="type" required>
                        <option value="">Select Type</option>
                        <option>Standard</option>
                        <option>Deluxe</option>
                        <option>Executive</option>
                        <option>Suite</option>
                    </select>
                </div>

                <div>
                    <label>Floor</label>
                    <input
                        type="number"
                        name="floor"
                        placeholder="Enter floor"
                        required>
                </div>

                <div>
                    <label>Capacity</label>
                    <input
                        type="number"
                        name="capacity"
                        placeholder="Guests Capacity"
                        required>
                </div>

                <div>
                    <label>Price Per Night</label>
                    <input
                        type="number"
                        name="pricePerNight"
                        placeholder="₹5000"
                        required>
                </div>

                <div>
                    <label>Status</label>
                    <select name="status" required>
                        <option>Available</option>
                        <option>Booked</option>
                        <option>Maintenance</option>
                    </select>
                </div>

            </div>

        </div>

        <div class="section">

            <label>Room Image</label>

            <div class="upload-box">
                <input
                    type="file"
                    name="image"
                    required>
            </div>

        </div>

        <button type="submit" class="btn">
            Create Room
        </button>

    </form>

</div>


    
</body>
