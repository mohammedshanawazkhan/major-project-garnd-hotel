<style>




/* ONE MAIN CONTAINER */
.search-container {
    width: 100%;
    max-width: 1270px;
    margin: auto;
    background: #fff;
    padding: 20px 48px;
    border-radius: 9px;
    box-shadow: 0 5px 18px rgba(0,0,0,0.18);

    display: flex;
    align-items: center;
    gap: 28px;
}

/* DATE RANGE */
.date-range {
    flex: 1.1;
    min-width: 0;
    height: 48px;
    border: 2px solid #444;
    border-radius: 4px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 10px;
}

.date-range input {
    width: 45%;
    min-width: 0;
    border: none;
    outline: none;
    font-size: 15px;
}

.date-range span {
    color: #aaa;
}

/* SEARCH */
.search-input {
    flex: 1;
    min-width: 0;
    height: 48px;
    border: 2px solid #444;
    border-radius: 4px;
    padding: 0 15px;
    font-size: 17px;
    outline: none;
}

/* DROPDOWN */
.room-select {
    flex: 1.1;
    min-width: 0;
    height: 48px;
    border: 2px solid #444;
    border-radius: 4px;
    padding: 0 15px;
    font-size: 16px;
    background: #fff;
    outline: none;
}

/* TABLET */
@media (max-width: 1024px) {
    .search-container {
        padding: 20px;
        gap: 15px;
        flex-wrap: wrap;
    }

    .date-range,
    .search-input {
        flex: 1 1 calc(50% - 10px);
    }

    .room-select {
        flex: 1 1 100%;
    }
}

/* MOBILE */
@media (max-width: 600px) {
    body {
        padding: 20px 12px;
    }

    .search-container {
        padding: 18px;
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
    }

    .date-range,
    .search-input,
    .room-select {
        width: 100%;
        flex: none;
        height: 46px;
    }

    .date-range input {
        font-size: 13px;
    }

    .search-input,
    .room-select {
        font-size: 15px;
    }
}
</style>


<div class="search-container">

    <div class="date-range">
        <input type="date" aria-label="Start date">
        <span>→</span>
        <input type="date" aria-label="End date">
    </div>

    <input
        type="text"
        class="search-input"
        placeholder="Search Rooms"
    >

    <select class="room-select">
        <option>All</option>
        <option>Single Room</option>
        <option>Double Room</option>
        <option>Deluxe Room</option>
        <option>Suite</option>
    </select>

</div>



  <%  for(let data of allData){ %>
        <div class="container">
         <div class="box">
            <div class="box-img">
                <a href="/rooms/<%=data._id%>"><img src="<%=data.image.url%>" alt=""></a>
            </div>
            <h3 id="h3"><%=data.type%></h3>
            <br>
            <h3 id="h3"><%=data.pricePerNight%></h3>
        </div>
        
    </div>
    <%}%>

    
    
</body>
