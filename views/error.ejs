<% layout("/layouts/boilerplate") %>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Error</title>
    <style>
       body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#ff9a9e,#fad0c4);
    font-family:sans-serif;
}

.box{
    text-align:center;
    background:white;
    padding:2rem 3rem;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(0,0,0,0.15);
}

h1{
    font-size:5rem;
    margin:0;
    color:#ff4d6d;
}

p{
    color:#555;
}

a{
    text-decoration:none;
    background:#ff4d6d;
    color:white;
    padding:10px 20px;
    border-radius:10px;
}

.emoji{
    font-size:4rem;
    margin-bottom:10px;
}
    </style>
</head>
<body>

    <div class="box">
        <div class="emoji">⚠️</div>
        <h1><%= status || 500 %></h1>
        <p><%=msg %></p>
        <br>
        <a href="/room">Go Home</a>
    </div>

</body>
</html>